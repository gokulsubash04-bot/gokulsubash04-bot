
<svg width="900" height="90" viewBox="0 0 900 90"
     xmlns="http://www.w3.org/2000/svg">

  <rect width="900" height="90" rx="12" fill="#0d1117"/>

  <!-- Stars / background -->
  <g fill="#30363d">
    <circle cx="80" cy="18" r="2"/>
    <circle cx="210" cy="70" r="2"/>
    <circle cx="350" cy="20" r="2"/>
    <circle cx="510" cy="70" r="2"/>
    <circle cx="680" cy="18" r="2"/>
    <circle cx="820" cy="70" r="2"/>
  </g>

  <!-- Ground -->
  <line x1="25" y1="68" x2="875" y2="68"
        stroke="#30363d" stroke-width="3"/>

  <!-- Dots -->
  <g fill="#f0f6fc">
    <circle cx="70" cy="48" r="3"/>
    <circle cx="115" cy="48" r="3"/>
    <circle cx="160" cy="48" r="3"/>
    <circle cx="205" cy="48" r="3"/>
    <circle cx="250" cy="48" r="3"/>
    <circle cx="295" cy="48" r="3"/>
    <circle cx="340" cy="48" r="3"/>
    <circle cx="385" cy="48" r="3"/>
    <circle cx="430" cy="48" r="3"/>
    <circle cx="475" cy="48" r="3"/>
    <circle cx="520" cy="48" r="3"/>
    <circle cx="565" cy="48" r="3"/>
    <circle cx="610" cy="48" r="3"/>
    <circle cx="655" cy="48" r="3"/>
    <circle cx="700" cy="48" r="3"/>
    <circle cx="745" cy="48" r="3"/>
    <circle cx="790" cy="48" r="3"/>
    <circle cx="835" cy="48" r="3"/>
  </g>

  <!-- Collectible tech symbols -->
  <g font-family="monospace"
     font-size="14"
     font-weight="bold"
     text-anchor="middle">

    <text x="250" y="30" fill="#36BCF7">PY</text>
    <text x="430" y="30" fill="#61DAFB">REACT</text>
    <text x="610" y="30" fill="#00C853">API</text>
    <text x="790" y="30" fill="#F7DF1E">AI</text>

  </g>

  <!-- Main character -->
  <g id="runner">

    <!-- body -->
    <path d="M0,-13
             A14,14 0 1,1 0,13
             L14,0 Z"
          fill="#FFD43B"/>

    <!-- eye -->
    <circle cx="1" cy="-7" r="2.5" fill="#0d1117"/>

    <!-- animation -->
    <animateTransform
      attributeName="transform"
      type="translate"
      values="-35 48;
              100 48;
              220 48;
              340 48;
              460 48;
              580 48;
              700 48;
              820 48;
              935 48;
              -35 48"
      dur="9s"
      repeatCount="indefinite"/>

  </g>

  <!-- Enemy -->
  <g id="enemy">

    <path d="M-13,10
             L-13,-5
             Q-13,-17 0,-17
             Q13,-17 13,-5
             L13,10
             L7,5
             L0,10
             L-7,5 Z"
          fill="#ff4d6d"/>

    <circle cx="-5" cy="-7" r="3" fill="white"/>
    <circle cx="5" cy="-7" r="3" fill="white"/>

    <circle cx="-5" cy="-7" r="1.5" fill="#0d1117"/>
    <circle cx="5" cy="-7" r="1.5" fill="#0d1117"/>

    <animateTransform
      attributeName="transform"
      type="translate"
      values="930 48;
              780 48;
              630 48;
              480 48;
              330 48;
              180 48;
              30 48;
              -40 48;
              930 48"
      dur="11s"
      repeatCount="indefinite"/>

  </g>

  <!-- Small text -->
  <text x="450" y="82"
        fill="#8b949e"
        font-family="monospace"
        font-size="10"
        text-anchor="middle">
    KEEP BUILDING • KEEP LEARNING • KEEP MOVING
  </text>

</svg>
